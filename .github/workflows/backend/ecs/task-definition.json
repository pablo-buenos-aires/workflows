{
  "family": "backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::836940249137:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::836940249137:role/ecsAppTaskRole",
  "containerDefinitions": [
    {
      "name": "backend-container",
      "image": "zaglushka",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "S3_BUCKET",
          "value": "photos-bucket666"
        },
        {
          "name": "DB_HOST",
          "value": "db-postgres-id.cnk6oeya6pzp.sa-east-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        }
      ],
      "secrets": [
        {
          "name": "COGNITO_USER_POOL_ID",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:836940249137:secret:db_credentials-NtiqzU:cognitouserpool::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:836940249137:secret:db_credentials-NtiqzU:awsregion::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:836940249137:secret:db_credentials-NtiqzU:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:836940249137:secret:db_credentials-NtiqzU:password::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:836940249137:secret:db_credentials-NtiqzU:dbname::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "region": "sa-east-1",
          "log_group_name": "/ecs/backend",
          "log_stream_prefix": "backend-",
          "auto_create_group": "true"
        }
      }
    },
    {
      "name": "log_router",
      "image": "836940249137.dkr.ecr.sa-east-1.amazonaws.com/fluentbit-router:v1",
      "essential": true,
     
      "memoryReservation": 64,
      "portMappings": [
        { "containerPort": 2020, "hostPort": 2020, "protocol": "tcp" },
        { "containerPort": 2021, "hostPort": 2021, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "log-router"
        }
      }
    },
    {
      "name": "xray-daemon",
      "image": "public.ecr.aws/xray/aws-xray-daemon:latest",
      "essential": true,
      "cpu": 32,
      "memoryReservation": 128,
      "portMappings": [
        {
          "containerPort": 2000,
          "hostPort": 2000,
          "protocol": "udp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "sa-east-1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "xray-daemon"
        }
      }
    },
    {
      "name": "prom-agent",
      "image": "836940249137.dkr.ecr.sa-east-1.amazonaws.com/prometheus-agent:v1",
      "essential": true,
      "cpu": 32,
      "memoryReservation": 128,
      "environment": [
        { "name": "AWS_REGION", "value": "sa-east-1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "prom-agent"
        }
      }
    }

  ]
}